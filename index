<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Financial Touch Quest SMA</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#eef2ff;color:#172033}
.app{max-width:1050px;margin:auto;padding:14px}
.hero{background:linear-gradient(135deg,#4338ca,#9333ea);color:#fff;border-radius:24px;padding:22px;text-align:center}
.hero h1{margin:5px 0;font-size:30px}.hero p{margin:5px;color:#ede9fe}
.input,.panel{background:#fff;border-radius:18px;padding:16px;margin-top:12px;box-shadow:0 4px 16px #0001}
.input{text-align:center}input{width:min(100%,380px);padding:13px;border:3px solid #7c3aed;border-radius:12px;font-size:22px;text-align:center;font-weight:bold}
.btn,.restart{border:0;background:#4f46e5;color:#fff;border-radius:12px;padding:13px 20px;font-weight:bold;cursor:pointer;margin-top:8px}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:12px}
.stat{background:#fff;border-radius:13px;padding:10px;text-align:center;box-shadow:0 3px 10px #0001}.stat small{display:block;color:#64748b}.stat b{font-size:17px}
.arena{position:relative;height:430px;background:linear-gradient(#7dd3fc 0 66%,#86efac 66%);border:4px solid #fff;border-radius:22px;overflow:hidden;margin-top:12px}
.cloud{position:absolute;font-size:35px;animation:cloud 13s linear infinite}.c1{top:45px;left:5%}.c2{top:90px;left:60%;animation-delay:-6s}
@keyframes cloud{to{transform:translateX(260px)}}
.ground{position:absolute;bottom:0;width:100%;height:34%;background:#4ade80;border-top:5px solid #22c55e}
.player{position:absolute;left:6%;bottom:28%;font-size:55px;z-index:20;transition:left .45s}.jump{animation:jump .65s ease-out}
@keyframes jump{0%{transform:translateY(0)}45%{transform:translateY(-125px) rotate(-7deg)}100%{transform:translateY(0)}}
.message{position:absolute;top:12px;left:50%;transform:translateX(-50%);background:#fff;padding:11px 15px;border-radius:12px;z-index:30;font-weight:bold;text-align:center;min-width:300px;box-shadow:0 4px 15px #0002}
.items{position:absolute;inset:0;z-index:15}
.item{position:absolute;top:52%;width:165px;min-height:108px;padding:10px;border-radius:16px;background:#fff;border:4px solid;box-shadow:0 7px 0 #0003;text-align:center;cursor:pointer;animation:slide linear forwards}
.item.good{border-color:#22c55e}.item.bad{border-color:#ef4444}
.item .emoji{font-size:34px;display:block}.item b{display:block;font-size:13px;line-height:1.2}.item small{font-size:10px;color:#64748b;display:block;margin-top:4px}
@keyframes slide{from{left:105%}to{left:-190px}}
.goal{position:absolute;right:2%;bottom:29%;font-size:43px;z-index:10}
.legend{display:grid;grid-template-columns:1fr 1fr;gap:10px}.legend>div{padding:12px;border-radius:12px;font-weight:bold}
.g{background:#dcfce7}.r{background:#fee2e2}
.end{display:none;text-align:center;padding:25px;margin-top:12px;border-radius:20px}.win{background:#dcfce7;border:3px solid #22c55e}.lose{background:#fee2e2;border:3px solid #ef4444}.big{font-size:60px}
@media(max-width:700px){.stats{grid-template-columns:1fr 1fr}.legend{grid-template-columns:1fr}.item{width:135px;min-height:98px}.message{min-width:235px;font-size:12px}.arena{height:400px}}
</style>
</head>
<body>
<div class="app">
<section class="hero">
<div style="font-size:45px">🧑‍🎓🏃‍♂️💨</div>
<h1>FINANCIAL TOUCH QUEST</h1>
<p>Sentuh pilihan yang lewat! Pilih <b>5 kebutuhan</b> dan hindari <b>5 pengeluaran boros</b>.</p>
</section>

<section class="input">
<b>💰 Masukkan uang saku 1 minggu</b><br>
<input id="money" type="number" min="1000" value="100000"><br>
<button class="btn" id="start">🚀 MULAI GAME</button>
</section>

<div class="stats">
<div class="stat">📅<small>Minggu</small><b id="week">1 / 4</b></div>
<div class="stat">💵<small>Uang</small><b id="cash">Rp100.000</b></div>
<div class="stat">🟢<small>Kebutuhan</small><b id="good">0 / 5</b></div>
<div class="stat">🔴<small>Boros</small><b id="bad">0 / 5</b></div>
<div class="stat">⭐<small>Skor</small><b id="score">0</b></div>
</div>

<section class="arena">
<div class="cloud c1">☁️</div><div class="cloud c2">☁️</div>
<div class="message" id="message">Tekan MULAI GAME!</div>
<div class="player" id="player">🧑‍🎓</div><div class="goal">🏁</div>
<div class="ground"></div><div class="items" id="items"></div>
</section>

<section class="panel">
<h2>🎯 Cara Bermain</h2>
<div class="legend">
<div class="g">🟢 SENTUH KEBUTUHAN<br><small>20 pilihan kebutuhan anak SMA akan muncul bergerak.</small></div>
<div class="r">🔴 HINDARI BOROS<br><small>20 pilihan boros akan muncul sebagai jebakan.</small></div>
</div>
<p><b>🏆 MENANG:</b> berhasil menyentuh 5 kebutuhan.</p>
<p><b>💸 KALAH:</b> menyentuh 5 pilihan boros. Simpanan akhir menjadi Rp0.</p>
</section>

<section id="win" class="end win">
<div class="big">🏆🎉</div><h2>KAMU MENANG!</h2>
<p>Hebat! Kamu berhasil memilih 5 kebutuhan.</p>
<b id="winText"></b><br><button class="restart" id="againW">🔄 MAIN LAGI</button>
</section>

<section id="lose" class="end lose">
<div class="big">💸😵</div><h2>KAMU KALAH!</h2>
<p>Kamu memilih 5 pengeluaran boros.</p>
<b id="loseText"></b><br><button class="restart" id="againL">🔄 COBA LAGI</button>
</section>
</div>

<script>
(function(){
const needs=[["🍚", "Makan"], ["🥤", "Minum"], ["✏️", "Alat tulis"], ["📚", "Buku pelajaran"], ["🎒", "Tas sekolah"], ["👟", "Sepatu sekolah"], ["👕", "Seragam"], ["🚌", "Transportasi"], ["📱", "Kuota internet"], ["🖨️", "Fotokopi tugas"], ["💻", "Perlengkapan belajar"], ["🧴", "Perlengkapan kebersihan"], ["💊", "Obat saat diperlukan"], ["📝", "Biaya kegiatan sekolah"], ["🎓", "Biaya les/kursus"], ["🧦", "Kaos kaki sekolah"], ["☔", "Perlengkapan hujan"], ["🪪", "Administrasi sekolah"], ["🔧", "Perawatan perlengkapan sekolah"], ["🏫", "Kegiatan belajar"]];
const wastes=[["🍔", "Terlalu sering jajan"], ["🧋", "Minuman kekinian"], ["☕", "Nongkrong"], ["🎮", "Top-up game"], ["🛒", "Belanja online impulsif"], ["👕", "Belanja karena tren"], ["👟", "Sering membeli sepatu baru"], ["📱", "Gonta-ganti gadget"], ["🎬", "Langganan hiburan berlebihan"], ["🍕", "Pesan makanan online"], ["🚕", "Transportasi mahal"], ["🎁", "Ikut-ikutan teman"], ["💳", "Checkout flash sale"], ["🛍️", "Membeli barang yang sudah punya"], ["🎧", "Aksesori gadget berlebihan"], ["💄", "Produk karena tren"], ["🎟️", "Terlalu sering jalan-jalan"], ["💸", "Pengeluaran kecil setiap hari"], ["📦", "Belanja karena gratis ongkir"], ["😎", "FOMO / takut ketinggalan tren"]];
const fmt=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Math.round(Math.max(0,n)));
let s={week:1,cash:100000,good:0,bad:0,score:0},timer=null,running=false;
const $=id=>document.getElementById(id);

function update(){
$('week').textContent=s.week+' / 4';
$('cash').textContent=fmt(s.cash);
$('good').textContent=s.good+' / 5';
$('bad').textContent=s.bad+' / 5';
$('score').textContent=s.score;
}
function reset(){
if(timer)clearTimeout(timer);running=false;
s={week:1,cash:Number($('money').value)||100000,good:0,bad:0,score:0};
$('items').innerHTML='';$('win').style.display='none';$('lose').style.display='none';
$('message').textContent='Tekan MULAI GAME!';update();
}
function start(){reset();running=true;$('message').textContent='🏃 Sentuh KEBUTUHAN! Hindari yang BOROS!';spawn();}
function spawn(){
if(!running)return;
const item=document.createElement('button');item.type='button';item.className='item';
const good=Math.random()<0.62;
const arr=good?needs:wastes;
const d=arr[Math.floor(Math.random()*arr.length)];
item.classList.add(good?'good':'bad');
item.innerHTML='<span class="emoji">'+d[0]+'</span><b>'+d[1]+'</b><small>'+(good?'🟢 KEBUTUHAN':'🔴 JEBakan BOROS')+'</small>';
item.style.animationDuration=(3.7+Math.random()*1.8)+'s';
item.style.top=(45+Math.random()*20)+'%';
item.addEventListener('click',()=>choose(item,good,d[1]));
$('items').appendChild(item);
setTimeout(()=>item.remove(),6500);
timer=setTimeout(spawn,520+Math.random()*650);
}
function choose(item,good,name){
if(!running)return;
item.remove();
const p=$('player');p.classList.remove('jump');void p.offsetWidth;p.classList.add('jump');
if(good){
s.good++;s.score+=100;s.cash=Math.max(0,s.cash-s.cash*.03);p.style.left='23%';
$('message').textContent='🟢 BENAR! '+name+' adalah kebutuhan. +100 ⭐';
}else{
s.bad++;s.score=Math.max(0,s.score-100);s.cash=Math.max(0,s.cash-s.cash*.20);p.style.left='52%';
$('message').textContent='🔴 JEBakan! '+name+' membuatmu boros. -100 ⭐';
}
update();
if(s.bad>=5){lose();return}
if(s.good>=5){win();return}
}
function win(){
running=false;clearTimeout(timer);$('items').innerHTML='';
$('win').style.display='block';
$('winText').textContent='💵 Uang tersisa: '+fmt(s.cash)+' • 🏦 Simpanan: '+fmt(s.cash)+' • ⭐ Skor: '+s.score;
}
function lose(){
running=false;clearTimeout(timer);$('items').innerHTML='';s.cash=0;update();
$('lose').style.display='block';
$('loseText').textContent='🔴 Boros: 5 / 5 • 🏦 Simpanan: Rp0';
}
$('start').addEventListener('click',start);
$('againW').addEventListener('click',start);
$('againL').addEventListener('click',start);
reset();
})();
</script>
</body></html>
