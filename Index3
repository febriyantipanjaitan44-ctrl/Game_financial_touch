<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>Financial Tap Rush</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial;background:#0f172a;color:#fff;touch-action:manipulation}.app{max-width:900px;margin:auto;padding:10px}
.top{display:flex;gap:6px;align-items:center;background:#1e293b;padding:9px;border-radius:16px}.title{font-weight:900;font-size:18px;flex:1}.money{background:#fff;color:#111;border-radius:10px;padding:3px 7px}.money input{width:100px;border:0;outline:0;font-size:16px;font-weight:900;text-align:right}.start,.restart{border:0;border-radius:10px;padding:10px;background:#22c55e;color:#052e16;font-weight:900}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:8px 0}.stat{background:#1e293b;padding:7px;border-radius:11px;text-align:center;font-size:11px}.stat b{display:block;font-size:14px;margin-top:2px}
.arena{height:510px;position:relative;overflow:hidden;border:3px solid white;border-radius:18px;background:linear-gradient(#38bdf8 0 65%,#86efac 65%)}.ground{position:absolute;bottom:0;width:100%;height:34%;background:#22c55e;border-top:4px solid #15803d}.player{position:absolute;left:5%;bottom:28%;font-size:48px;z-index:20;transition:left .3s}.jump{animation:j .4s}@keyframes j{45%{transform:translateY(-95px) rotate(-8deg)}}
.msg{position:absolute;top:9px;left:50%;transform:translateX(-50%);background:#fff;color:#111;padding:8px 12px;border-radius:11px;font-size:12px;font-weight:900;z-index:50;white-space:nowrap}
.items{position:absolute;inset:0;z-index:30}.item{position:absolute;width:105px;min-height:76px;border:3px solid;border-radius:12px;background:#fff;color:#111;padding:5px;box-shadow:0 5px 0 #0003;text-align:center;cursor:pointer;animation:move linear forwards}.good{border-color:#16a34a}.bad{border-color:#dc2626}.item .e{display:block;font-size:23px}.item b{display:block;font-size:10px;line-height:1.05}.item small{font-size:8px;color:#64748b}@keyframes move{from{left:105%}to{left:-120px}}
.level{position:absolute;bottom:5px;left:50%;transform:translateX(-50%);background:#0f172ddd;padding:6px 12px;border-radius:99px;font-size:11px;font-weight:900;z-index:45}.finish{position:absolute;right:2%;bottom:29%;font-size:35px;z-index:10}
.info{background:#1e293b;border-radius:15px;padding:12px;margin-top:9px;font-size:12px}.info h3{margin:0 0 6px}.end{display:none;text-align:center;padding:22px;border-radius:18px;margin-top:10px}.win{background:#14532d}.lose{background:#7f1d1d}.big{font-size:52px}
@media(max-width:500px){.title{font-size:14px}.money input{width:72px}.start{padding:9px 7px}.arena{height:500px}.item{width:92px;min-height:70px}.msg{min-width:220px;text-align:center}}
</style></head><body><div class="app">
<div class="top"><div class="title">🎮 FINANCIAL TAP RUSH</div><div class="money">Rp <input id="money" type="number" value="100000" min="1000" inputmode="numeric"></div><button class="start" id="start">▶ MULAI</button></div>
<div class="stats"><div class="stat">🏁 LEVEL<b id="level">1</b></div><div class="stat">💵 UANG<b id="cash">Rp100.000</b></div><div class="stat">🟢 BENAR<b id="good">0 / 5</b></div><div class="stat">🔴 BOROS<b id="bad">0 / 5</b></div></div>
<div class="arena"><div class="msg" id="msg">Masukkan uang lalu tekan MULAI</div><div class="player" id="player">🧑‍🎓</div><div class="finish">🏁</div><div class="ground"></div><div class="items" id="items"></div><div class="level" id="levelText">LEVEL 1 • PELAN</div></div>
<div class="info"><h3>👆 Sentuh yang benar!</h3>🟢 Kebutuhan = <b>PILIH</b> &nbsp; 🔴 Boros = <b>HINDARI</b><br>🏆 5 kebutuhan = MENANG &nbsp; 💸 5 boros = KALAH</div>
<section id="win" class="end win"><div class="big">🏆</div><h2>MENANG!</h2><p>Kamu berhasil memilih 5 kebutuhan.</p><b id="winText"></b><br><button class="restart" id="againW">🔄 MAIN LAGI</button></section>
<section id="lose" class="end lose"><div class="big">💸</div><h2>KALAH!</h2><p>Kamu memilih 5 pengeluaran boros.</p><b id="loseText"></b><br><button class="restart" id="againL">🔄 COBA LAGI</button></section>
</div>
<script>
(function(){
const needs=[["🍚", "Makan"], ["🥤", "Minum"], ["✏️", "Alat tulis"], ["📚", "Buku"], ["🎒", "Tas"], ["👟", "Sepatu"], ["👕", "Seragam"], ["🚌", "Transportasi"], ["📱", "Kuota"], ["🖨️", "Fotokopi"], ["💻", "Perlengkapan belajar"], ["🧴", "Kebersihan"], ["💊", "Obat"], ["📝", "Kegiatan sekolah"], ["🎓", "Les/kursus"], ["🧦", "Kaos kaki"], ["☔", "Perlengkapan hujan"], ["🪪", "Administrasi"], ["🔧", "Perawatan perlengkapan"], ["🏫", "Kegiatan belajar"]],wastes=[["🍔", "Jajan berlebihan"], ["🧋", "Minuman kekinian"], ["☕", "Nongkrong"], ["🎮", "Top-up game"], ["🛒", "Belanja impulsif"], ["👕", "Belanja tren"], ["👟", "Sepatu baru"], ["📱", "Gonta-ganti gadget"], ["🎬", "Langganan hiburan"], ["🍕", "Pesan makanan"], ["🚕", "Transportasi mahal"], ["🎁", "Ikut teman"], ["💳", "Flash sale"], ["🛍️", "Barang sudah punya"], ["🎧", "Aksesori gadget"], ["💄", "Produk tren"], ["🎟️", "Jalan-jalan"], ["💸", "Jajan kecil tiap hari"], ["📦", "Gratis ongkir"], ["😎", "FOMO"]],$=id=>document.getElementById(id),fmt=n=>new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(Math.round(Math.max(0,n)));
let s,timer,running=false;
function update(){$('level').textContent=s.level;$('cash').textContent=fmt(s.cash);$('good').textContent=s.good+' / 5';$('bad').textContent=s.bad+' / 5'}
function reset(){if(timer)clearTimeout(timer);running=false;s={level:1,cash:Number($('money').value)||100000,good:0,bad:0,score:0};$('items').innerHTML='';$('win').style.display='none';$('lose').style.display='none';$('msg').textContent='Masukkan uang lalu tekan MULAI';$('levelText').textContent='LEVEL 1 • PELAN';update()}
function start(){reset();s.cash=Math.max(1000,Number($('money').value)||100000);running=true;$('msg').textContent='🏃 Sentuh KEBUTUHAN! Hindari BOROS!';spawn();update()}
function spawn(){if(!running)return;let el=document.createElement('button');el.className='item';el.type='button';let good=Math.random()<.65,arr=good?needs:wastes,d=arr[Math.floor(Math.random()*arr.length)];el.classList.add(good?'good':'bad');el.innerHTML='<span class="e">'+d[0]+'</span><b>'+d[1]+'</b><small>'+(good?'🟢 KEBUTUHAN':'🔴 BOROS')+'</small>';let speed=Math.max(1.6,4.7-(s.level-1)*.7)+Math.random()*.4;el.style.animationDuration=speed+'s';el.style.top=(44+Math.random()*24)+'%';el.onclick=()=>pick(el,good,d[1]);$('items').appendChild(el);setTimeout(()=>el.remove(),6000);timer=setTimeout(spawn,Math.max(250,650-(s.level-1)*90))}
function pick(el,good,name){if(!running)return;el.remove();let p=$('player');p.classList.remove('jump');void p.offsetWidth;p.classList.add('jump');if(good){s.good++;s.score+=100;s.cash=Math.max(0,s.cash-s.cash*.02);p.style.left='25%';$('msg').textContent='🟢 BENAR! '+name+' +100 ⭐'}else{s.bad++;s.score=Math.max(0,s.score-100);s.cash=Math.max(0,s.cash*.25);p.style.left='52%';$('msg').textContent='🔴 BOROS! '+name+' -25% uang'}s.level=Math.min(5,1+Math.floor((s.good+s.bad)/3));$('levelText').textContent='LEVEL '+s.level+' • '+(s.level>=4?'SUPER CEPAT':s.level>=2?'LEBIH CEPAT':'PELAN');update();if(s.good>=5){win();return}if(s.bad>=5){lose();return}}
function win(){running=false;clearTimeout(timer);$('items').innerHTML='';$('win').style.display='block';$('winText').textContent='💵 Uang tersisa: '+fmt(s.cash)+' • 🏦 Simpanan: '+fmt(s.cash)+' • ⭐ '+s.score}
function lose(){running=false;clearTimeout(timer);$('items').innerHTML='';s.cash=0;update();$('lose').style.display='block';$('loseText').textContent='🔴 Boros 5 / 5 • 🏦 Simpanan: Rp0'}
$('start').onclick=start;$('againW').onclick=start;$('againL').onclick=start;reset();
})();
</script></body></html>
